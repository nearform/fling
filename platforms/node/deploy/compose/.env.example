# Copy to .env beside compose.yaml and fill in. Placeholders only: never commit the real file.
# Generate each secret with: openssl rand -base64 32

# The instance's addresses. Sites are https://<name>.<FLING_SITES_DOMAIN>; the sites domain may be
# the app host itself. The storage host serves the presigned upload and download URLs (MinIO
# through Caddy): pick one outside *.FLING_SITES_DOMAIN, or it hides the site of the same name.
FLING_APP_HOST=fling.example.com
FLING_SITES_DOMAIN=fling.example.com
FLING_STORAGE_HOST=fling-storage.example.com

# Secrets (at least 32 characters each).
SESSION_SECRET=change-me
SITE_HMAC_KEY=change-me
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
S3_SECRET_ACCESS_KEY=change-me
# Optional: the bearer token for POST /ticks/* (an outside scheduler, the migrate call).
TICK_SECRET=

# The wildcard certificate: Let's Encrypt over ACME DNS-01. CADDY_DNS_MODULE is the caddy-dns
# module built into Caddy; ACME_DNS_PROVIDER its name in the Caddyfile; ACME_DNS_API_TOKEN a token
# that may edit the zone's TXT records.
ACME_EMAIL=ops@example.com
CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_API_TOKEN=change-me

# The Node host image: built from this checkout by default, or a published tag.
# FLING_IMAGE=ghcr.io/<owner>/fling-node:<release>
