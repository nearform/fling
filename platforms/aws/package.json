{
  "name": "@fling/platform-aws",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Fling on AWS: the Lambda entry point and the DynamoDB, S3, CloudFront KeyValueStore and SSM adapters. `build` bundles the API core with them into dist/lambda.zip.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:rehearse": "tsx scripts/migrate-rehearse.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront-keyvaluestore": "3.1150.0",
    "@aws-sdk/client-dynamodb": "3.1150.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/client-ssm": "3.1150.0",
    "@aws-sdk/lib-dynamodb": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@aws-sdk/signature-v4a": "^3.1138.0",
    "@fling/api": "workspace:*",
    "@fling/shared": "workspace:*",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@fling/conformance": "workspace:*",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
