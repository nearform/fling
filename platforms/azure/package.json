{
  "name": "@fling/platform-azure",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Fling on Azure: the Node host (platforms/node) on Container Apps with the Cosmos DB, Blob Storage, Web PubSub and Communication Services Email adapters. `build` bundles it into dist/main.mjs, the container image's entry point (Dockerfile).",
  "type": "module",
  "scripts": {
    "build": "echo 'platform-azure: consumed as source'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/communication-email": "1.1.0",
    "@azure/cosmos": "4.10.2",
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "@azure/web-pubsub": "1.2.0",
    "@fling/api": "workspace:*",
    "@fling/platform-node": "workspace:*",
    "@fling/shared": "workspace:*",
    "@hono/node-server": "^2.1.6"
  },
  "devDependencies": {
    "@fling/conformance": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
