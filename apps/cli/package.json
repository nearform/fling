{
  "name": "@nearform/fling",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Fling a folder of static files at fling.labs.nearform.com and get a link back. CLI + MCP server.",
  "type": "module",
  "bin": {
    "fling": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearform/fling.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "build:mcpb": "node scripts/build.mjs && node scripts/build-mcpb.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "ignore": "^7.0.5",
    "mime": "^4.1.0",
    "open": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fling/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
