{
  "name": "@fling/platform-node",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Fling on Node: the Postgres Table, for the platforms that run on Node. Consumed as TypeScript source.",
  "type": "module",
  "exports": {
    "./table/postgres": "./src/table/postgres.ts",
    "./table/schema": "./src/table/schema.ts",
