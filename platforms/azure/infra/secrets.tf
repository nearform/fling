# The app's secrets are Key Vault secrets (RBAC authorisation). The app never calls Key Vault: each
# one is a Container Apps secret that references it (`key_vault_secret_id`, read by the platform
# with the app's identity), exposed to the app and the jobs as an environment variable (api.tf).
# A new value reaches replicas that start after it is set: restart the revision, or redeploy.
#
# - generated_secrets (session-secret, site-hmac-key): 40 random characters, generated in memory
#   (ephemeral) and written with a write-only attribute, so never in state. Bump secrets_version
#   to regenerate them.
# - manual_secrets (oidc-client-secret; google-client-id and google-client-secret for a Google
#   client): created with the value "unset". Someone writes the real value with
#   `az keyvault secret set` (DEPLOY.md). Terraform never reads it back, so that is not drift.
# - origin-verify-secret and live-events-secret: Terraform must know them, so they are in state.
#   Front Door sends the first to the app as the X-Origin-Verify header (edge.tf), and Web PubSub
#   sends the second in its event handler's URL (live.tf). Each only proves a request came through
#   this Front Door, or from this Web PubSub's hub.
#
# Whoever runs Terraform writes the secrets, so it is given Key Vault Secrets Officer on the vault.

locals {
  # The env name each secret reaches the app as.
  secret_env = {
    "session-secret"       = "SESSION_SECRET"
    "site-hmac-key"        = "SITE_HMAC_KEY"
    "origin-verify-secret" = "ORIGIN_VERIFY_SECRET"
    "live-events-secret"   = "LIVE_EVENTS_SECRET"
    "oidc-client-secret"   = "OIDC_CLIENT_SECRET"
    "google-client-id"     = "GOOGLE_CLIENT_ID"
    "google-client-secret" = "GOOGLE_CLIENT_SECRET"
  }

  secret_ids = merge(
    { for k, s in azurerm_key_vault_secret.generated : k => s.versionless_id },
    { for k, s in azurerm_key_vault_secret.manual : k => s.versionless_id },
    {
      "origin-verify-secret" = azurerm_key_vault_secret.origin_verify.versionless_id
      "live-events-secret"   = azurerm_key_vault_secret.live_events.versionless_id
    },
  )
}

resource "azurerm_key_vault" "this" {
  name                = local.global.key_vault
  location            = var.location
  resource_group_name = local.resource_group_name
  tenant_id           = data.azurerm_client_config.current.tenant_id
  sku_name            = "standard"

  rbac_authorization_enabled = true
  purge_protection_enabled   = true
  soft_delete_retention_days = 30

  tags = local.tags
}

resource "azurerm_role_assignment" "terraform_secrets" {
  scope                = azurerm_key_vault.this.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = data.azurerm_client_config.current.object_id
}

ephemeral "random_password" "generated" {
  for_each = toset(var.generated_secrets)

  length  = 40
  special = false
}

resource "azurerm_key_vault_secret" "generated" {
  for_each = toset(var.generated_secrets)

  name         = each.key
  key_vault_id = azurerm_key_vault.this.id
  content_type = "generated by Terraform (write-only, not in state)"

  value_wo         = ephemeral.random_password.generated[each.key].result
  value_wo_version = var.secrets_version

  depends_on = [azurerm_role_assignment.terraform_secrets]
}

resource "azurerm_key_vault_secret" "manual" {
  for_each = toset(var.manual_secrets)

  name         = each.key
  key_vault_id = azurerm_key_vault.this.id
  content_type = "written by hand or script, never by Terraform"

  # A placeholder, written once. The real value goes in with az keyvault secret set.
  value_wo         = "unset"
  value_wo_version = 1

  depends_on = [azurerm_role_assignment.terraform_secrets]
}

resource "random_password" "origin_verify" {
  length  = 40
  special = false

  keepers = {
    version = var.secrets_version
  }
}

resource "azurerm_key_vault_secret" "origin_verify" {
  name         = "origin-verify-secret"
  key_vault_id = azurerm_key_vault.this.id
  content_type = "the X-Origin-Verify header Front Door sends to the app"

  value_wo         = random_password.origin_verify.result
  value_wo_version = var.secrets_version

  depends_on = [azurerm_role_assignment.terraform_secrets]
}

resource "random_password" "live_events" {
  length  = 40
  special = false

  keepers = {
    version = var.secrets_version
  }
}

resource "azurerm_key_vault_secret" "live_events" {
  name         = "live-events-secret"
  key_vault_id = azurerm_key_vault.this.id
  content_type = "the code Web PubSub's event handler sends to the app"

  value_wo         = random_password.live_events.result
  value_wo_version = var.secrets_version

  depends_on = [azurerm_role_assignment.terraform_secrets]
}
