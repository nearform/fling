{
  "name": "@fling/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The cloud-agnostic API core: the Hono app, its ports (Table, Blobs, RouteTable), Records (the domain persistence over Table), the data migrations and the dev/test adapters. Platforms (platforms/*) bundle it with their own entry point and adapters. Consumed as TypeScript source.",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./deps": "./src/deps.ts",
    "./types": "./src/types.ts",
    "./live": "./src/live.ts",
    "./mail": "./src/mail/types.ts",
    "./mail/memory": "./src/mail/memory.ts",
    "./mail/file": "./src/mail/file.ts",
    "./notifications": "./src/notifications/index.ts",
    "./revocations": "./src/revocations.ts",
    "./blobs": "./src/blobs/types.ts",
    "./blobs/fs": "./src/blobs/fs.ts",
    "./blobs/signed-upload": "./src/blobs/signed-upload.ts",
    "./route-table": "./src/route-table/types.ts",
    "./route-table/memory": "./src/route-table/memory.ts",
    "./route-table/table": "./src/route-table/table.ts",
    "./store": "./src/store/types.ts",
    "./store/records": "./src/store/records.ts",
    "./table": "./src/table/types.ts",
    "./table/memory": "./src/table/memory.ts",
    "./migrations": "./src/migrations/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "echo 'api: consumed as source (platforms/* bundle it)'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fling/shared": "workspace:*",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.5",
    "jose": "^6.2.12",
    "oauth4webapi": "^3.8.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fling/edge": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.21.0"
  }
}
