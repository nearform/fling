# The app's secrets are SSM SecureString parameters under /<namespace>/<env>/<name>/ (standard tier:
# free). The function reads them all at cold start (GetParametersByPath). No value is in Terraform
# state, except X-Origin-Verify (see below).
#
# - generated_secrets: 40 random characters, generated in memory (ephemeral) and written with a
#   write-only attribute. Bump secrets_version to regenerate them.
# - manual_secrets: created with the value "unset". Someone writes the real value with
#   `aws ssm put-parameter --overwrite` (oidc-client-secret: the sign-in client's secret). Terraform
#   never reads it back, so that is not drift.
# - origin-verify-secret: CloudFront sends it to the function URL as the X-Origin-Verify header, so
#   Terraform must know it, and it is in state through the distribution anyway. It only proves a
#   request came through this distribution.

ephemeral "random_password" "generated" {
  for_each = toset(var.generated_secrets)

  length  = 40
  special = false
}

resource "aws_ssm_parameter" "generated" {
  for_each = toset(var.generated_secrets)

  name        = "${local.ssm_prefix}${each.key}"
  description = "${var.name} (${var.env}): generated by Terraform (write-only, not in state)."
  type        = "SecureString"

  value_wo         = ephemeral.random_password.generated[each.key].result
  value_wo_version = var.secrets_version
}

resource "aws_ssm_parameter" "manual" {
  for_each = toset(var.manual_secrets)

  name        = "${local.ssm_prefix}${each.key}"
  description = "${var.name} (${var.env}): written by hand or script, never by Terraform."
  type        = "SecureString"

  # A placeholder, written once. The real value goes in with aws ssm put-parameter --overwrite.
  value_wo         = "unset"
  value_wo_version = 1
}

resource "random_password" "origin_verify" {
  length  = 40
  special = false

  keepers = {
    version = var.secrets_version
  }
}

resource "aws_ssm_parameter" "origin_verify" {
  name        = "${local.ssm_prefix}origin-verify-secret"
  description = "${var.name} (${var.env}): the X-Origin-Verify header CloudFront sends to the function URL."
  type        = "SecureString"

  value_wo         = random_password.origin_verify.result
  value_wo_version = var.secrets_version
}
