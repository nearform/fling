# The instance's own configuration, passed to the Node host as it is (copy to fling.env). Every key
# is in platforms/aws/DEPLOY.md, Instance configuration; secrets among them (OIDC_CLIENT_SECRET,
# SMTP_PASSWORD) belong here too, never in the compose file. Placeholders only.
INSTANCE_NAME=Fling
ALLOWED_EMAIL_DOMAINS=example.com
ADMIN_EMAILS=admin@example.com
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=change-me.apps.googleusercontent.com
OIDC_CLIENT_SECRET=change-me
# MAIL_DRIVER=smtp
# MAIL_FROM=fling@mail.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
