  },
  "scripts": {
    "build": "echo 'platform-node: consumed as source'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fling/api": "workspace:*",
    "@fling/shared": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fling/conformance": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
